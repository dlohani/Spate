{
  "manifest_version": 3,
  "name": "Spate Download Capture",
  "version": "1.0.0",
  "key": "",
  "description": "Automatically send downloads started in the browser to the Spate app, with cookies and referrer.",
  "permissions": [
    "downloads",
    "cookies",
    "storage",
    "alarms",
    "nativeMessaging",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Spate",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
