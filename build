#!/usr/bin/env bash
# Spate build front door: one command per platform, always from the working
# tree (uncommitted changes included). Finished artifacts land in
# dist/{macos,windows,linux,extension,android,ios}/ with the version in the
# name; everything else under dist/ is build intermediates.
#
#   ./build mac        [--install]   Flutter app + libspate -> spate-macos-<v>.pkg
#   ./build windows                  cross-compiled Go pieces + spate-setup.exe (+ NSIS installer)
#   ./build linux      [--cli-only]  Debian package (full on Linux, CLI-only elsewhere)
#   ./build android                  libspate .aar (gomobile) + APK when the Android SDK is present
#   ./build ios                      Spate.xcframework (gomobile) + unsigned iOS app
#   ./build extension                Chrome/Firefox zips, Safari source (+ Safari app on macOS)
#   ./build all                      everything this host can build
#   ./build release <target...>      same, but refuses unless the tree is clean and HEAD is tagged;
#                                    builds obfuscated (needs garble; see docs/delivery.md)
#   ./build version                  print the version and the build label
#   ./build bump <x.y.z>             set the version everywhere (VERSION, pubspec, manifests, casks)
#   ./build clean                    remove dist/
#
# Options: --no-test skips go vet/test; --install (mac) installs the result.
#
# Versioning: VERSION is stamped into binaries, bundles and installers as
# x.y.z. Artifact file names add "+<sha>" when the tree is ahead of the last
# tag and ".dirty" when it has uncommitted changes, so a dev build is never
# mistaken for the release while installers still compare plain x.y.z.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
export PATH="/opt/homebrew/bin:/usr/local/go/bin:$HOME/go/bin:$HOME/.local/go/bin:$PATH"
DIST="$ROOT/dist"
. "$ROOT/scripts/lib/bundle.sh"
. "$ROOT/scripts/lib/sha256.sh"
. "$ROOT/scripts/lib/obfuscate.sh"

VERSION="$(tr -d '[:space:]' < VERSION)"
SHA="$(git rev-parse --short HEAD 2>/dev/null || echo nogit)"
DIRTY=""; [ -n "$(git status --porcelain 2>/dev/null)" ] && DIRTY=".dirty"
# Only the release tag v$VERSION makes a release-named build; other tags on
# HEAD (such as the per-build tags CI creates) must not.
on_release_tag() { git tag --points-at HEAD 2>/dev/null | grep -qx "v$VERSION"; }
TAGGED=""; on_release_tag && TAGGED=1
LABEL="$VERSION"
if [ -z "$TAGGED" ] || [ -n "$DIRTY" ]; then LABEL="$VERSION+$SHA$DIRTY"; fi
BUILDNUM="$(git rev-list --count HEAD 2>/dev/null || echo 1)"
export SPATE_BUILD_NUMBER="$BUILDNUM"

# require_release: a release-labelled build needs a clean tree on tag v$VERSION and
# must carry the UI.
require_release() {
  local why=""
  [ -z "$DIRTY" ] || why="uncommitted changes"
  on_release_tag || why="${why:+$why, }HEAD is not on tag v$VERSION"
  [ -z "${SPATE_ALLOW_NO_UI:-}" ] || why="${why:+$why, }SPATE_ALLOW_NO_UI is set"
  if [ -n "$why" ]; then
    echo "release: refused ($why). Commit, tag v$VERSION, unset overrides, then retry." >&2
    exit 2
  fi
}

say()  { printf '\033[1m==> %s\033[0m\n' "$*"; }
note() { printf '    %s\n' "$*"; }
# need CMD HINT: 1 when CMD is missing (the caller skips that piece); under
# release a missing toolchain is fatal instead.
need() { command -v "$1" >/dev/null 2>&1 || { note "missing: $1 ($2)"; [ "$RELEASE" = 1 ] && { echo "release: cannot continue without $1" >&2; exit 2; }; return 1; }; }

# persist_path DIR: ensures DIR is permanently added to the user's shell PATH
# across macOS, Linux, and Windows for future terminal sessions.
persist_path() {
  local dir="$1"
  [ -d "$dir" ] || return 0

  local os="$(uname -s 2>/dev/null || echo unknown)"
  case "$os" in
    Darwin)
      # macOS: default shell is zsh; also update bash configs if present
      local f
      for f in "$HOME/.zshrc" "$HOME/.bash_profile" "$HOME/.bashrc"; do
        if [ -f "$f" ] || [ "$(basename "$f")" = ".zshrc" ]; then
          if ! grep -qsF "$dir" "$f" 2>/dev/null; then
            printf '\n# Added by Spate build\nexport PATH="%s:$PATH"\n' "$dir" >> "$f"
            note "persisted $dir to $f"
          fi
        fi
      done
      ;;
    Linux)
      # Linux: profile, bashrc, and zshrc if present
      local f
      for f in "$HOME/.profile" "$HOME/.bashrc" "$HOME/.zshrc"; do
        if [ -f "$f" ] || [ "$(basename "$f")" = ".profile" ] || [ "$(basename "$f")" = ".bashrc" ]; then
          if ! grep -qsF "$dir" "$f" 2>/dev/null; then
            printf '\n# Added by Spate build\nexport PATH="%s:$PATH"\n' "$dir" >> "$f"
            note "persisted $dir to $f"
          fi
        fi
      done
      ;;
    CYGWIN*|MINGW*|MSYS*)
      # Windows: User environment variable via PowerShell
      if command -v powershell.exe >/dev/null 2>&1; then
        local win_dir="$dir"
        command -v cygpath >/dev/null 2>&1 && win_dir="$(cygpath -w "$dir")"
        powershell.exe -NoProfile -Command "
          \$target = '$win_dir';
          \$userPath = [Environment]::GetEnvironmentVariable('Path', 'User');
          if (\$userPath) {
            \$parts = \$userPath -split ';';
            if (\$parts -notcontains \$target) {
              [Environment]::SetEnvironmentVariable('Path', \"\$target;\$userPath\", 'User');
            }
          } else {
            [Environment]::SetEnvironmentVariable('Path', \$target, 'User');
          }
        " >/dev/null 2>&1 || true
        note "persisted $win_dir to Windows User PATH"
      fi
      # Also update Git Bash / MSYS profile if present
      local f
      for f in "$HOME/.bash_profile" "$HOME/.bashrc"; do
        if [ -f "$f" ]; then
          if ! grep -qsF "$dir" "$f" 2>/dev/null; then
            printf '\n# Added by Spate build\nexport PATH="%s:$PATH"\n' "$dir" >> "$f"
            note "persisted $dir to $f"
          fi
        fi
      done
      ;;
  esac
}

# ensure_go checks if the Go toolchain is available on the host machine
# (macOS, Linux, or Windows) and automatically installs Go if missing.
ensure_go() {
  local p
  for p in \
    "/usr/local/go/bin" \
    "/opt/homebrew/bin" \
    "/usr/local/bin" \
    "$HOME/go/bin" \
    "$HOME/.local/go/bin" \
    "/c/Program Files/Go/bin" \
    "/c/Go/bin" \
    "${LOCALAPPDATA:-}/Programs/Go/bin"; do
    if [ -d "$p" ] && [[ ":$PATH:" != *":$p:"* ]]; then
      export PATH="$p:$PATH"
    fi
  done

  if command -v go >/dev/null 2>&1; then
    return 0
  fi

  say "Go is not installed; auto-installing Go..."
  local os="$(uname -s 2>/dev/null || echo unknown)"
  local arch="$(uname -m 2>/dev/null || echo amd64)"
  local go_arch="amd64"
  case "$arch" in
    x86_64|amd64)   go_arch="amd64" ;;
    arm64|aarch64)  go_arch="arm64" ;;
    armv6l|armv7l)  go_arch="armv6l" ;;
  esac

  case "$os" in
    Darwin)
      if command -v brew >/dev/null 2>&1; then
        note "installing Go via Homebrew"
        brew install go
      else
        note "Homebrew not found; installing official Go release to $HOME/.local/go"
        local ver
        ver="$(curl -sSL --max-time 10 "https://go.dev/VERSION?m=text" 2>/dev/null | head -1 || true)"
        [ -n "$ver" ] || ver="go1.24.0"
        mkdir -p "$HOME/.local"
        curl -sSL "https://go.dev/dl/${ver}.darwin-${go_arch}.tar.gz" | tar -C "$HOME/.local" -xz
        export PATH="$HOME/.local/go/bin:$PATH"
      fi
      ;;
    Linux)
      note "installing official Go release to $HOME/.local/go"
      local ver
      ver="$(curl -sSL --max-time 10 "https://go.dev/VERSION?m=text" 2>/dev/null | head -1 || true)"
      [ -n "$ver" ] || ver="go1.24.0"
      mkdir -p "$HOME/.local"
      if curl -sSL "https://go.dev/dl/${ver}.linux-${go_arch}.tar.gz" 2>/dev/null | tar -C "$HOME/.local" -xz 2>/dev/null; then
        export PATH="$HOME/.local/go/bin:$PATH"
      elif command -v apt-get >/dev/null 2>&1; then
        note "falling back to apt-get"
        local sudo_cmd=""
        [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1 && sudo_cmd="sudo"
        $sudo_cmd apt-get update && $sudo_cmd apt-get install -y golang-go
      elif command -v dnf >/dev/null 2>&1; then
        note "falling back to dnf"
        local sudo_cmd=""
        [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1 && sudo_cmd="sudo"
        $sudo_cmd dnf install -y golang
      elif command -v pacman >/dev/null 2>&1; then
        note "falling back to pacman"
        local sudo_cmd=""
        [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1 && sudo_cmd="sudo"
        $sudo_cmd pacman -S --noconfirm go
      fi
      ;;
    CYGWIN*|MINGW*|MSYS*)
      if command -v winget.exe >/dev/null 2>&1; then
        note "installing Go via winget"
        winget.exe install --id GoLang.Go -e --silent --accept-source-agreements --accept-package-agreements || true
      elif command -v choco >/dev/null 2>&1; then
        note "installing Go via Chocolatey"
        choco install golang -y --no-progress
      elif command -v scoop >/dev/null 2>&1; then
        note "installing Go via Scoop"
        scoop install go
      elif command -v powershell.exe >/dev/null 2>&1; then
        note "installing official Go release via PowerShell"
        local ver
        ver="$(curl -sSL --max-time 10 "https://go.dev/VERSION?m=text" 2>/dev/null | head -1 || true)"
        [ -n "$ver" ] || ver="go1.24.0"
        powershell.exe -NoProfile -Command "
          \$dest = [System.IO.Path]::Combine(\$env:LOCALAPPDATA, 'Programs');
          New-Item -ItemType Directory -Force -Path \$dest | Out-Null;
          \$zip = [System.IO.Path]::Combine(\$env:TEMP, 'go.zip');
          Invoke-WebRequest -Uri 'https://go.dev/dl/${ver}.windows-${go_arch}.zip' -OutFile \$zip;
          Expand-Archive -Path \$zip -DestinationPath \$dest -Force;
          Remove-Item \$zip -Force;
        " || true
      fi
      for wp in "/c/Program Files/Go/bin" "/c/Go/bin" "${LOCALAPPDATA:-}/Programs/Go/bin" "$HOME/go/bin"; do
        [ -d "$wp" ] && export PATH="$wp:$PATH"
      done
      ;;
    *)
      note "unsupported OS for auto-install: $os"
      ;;
  esac

  for p in \
    "/usr/local/go/bin" \
    "/opt/homebrew/bin" \
    "/usr/local/bin" \
    "$HOME/go/bin" \
    "$HOME/.local/go/bin" \
    "/c/Program Files/Go/bin" \
    "/c/Go/bin" \
    "${LOCALAPPDATA:-}/Programs/Go/bin"; do
    if [ -d "$p" ] && [[ ":$PATH:" != *":$p:"* ]]; then
      export PATH="$p:$PATH"
    fi
  done

  if ! command -v go >/dev/null 2>&1; then
    echo "build: Go toolchain is required but could not be installed automatically. Please install Go (>= 1.22) from https://go.dev/dl/." >&2
    exit 2
  fi
  local go_bin_dir
  go_bin_dir="$(dirname "$(command -v go)")"
  persist_path "$go_bin_dir"
  say "Go ready: $(go version)"
}
artifacts=()
# label SRC PLATFORM [NAME]: moves a finished artifact into dist/<platform>/
# under its labelled name (version -> label) and records it. NAME is the
# published file name (containing $VERSION): every release file starts with
# "spate-<platform>-" so the files of one platform sit together in a release.
# Intermediates (dist/windows-amd64, linux-*, libspate.*, *-extension/
# sources) stay in place.
label() {
  local src="$1" plat="$2" name dst
  [ -e "$src" ] || return 0
  name="${3:-$(basename "$src")}"
  [ "$LABEL" != "$VERSION" ] && name="${name/$VERSION/$LABEL}"
  mkdir -p "$DIST/$plat"
  dst="$DIST/$plat/$name"
  rm -rf "$dst"
  mv -f "$src" "$dst"
  rm -f "$src.sha256"
  [ -f "$dst" ] && sha256_file "$dst" | sed "s|$DIST/||" > "$dst.sha256"
  artifacts+=("$dst")
}

TEST=1; INSTALL=0; CLI_ONLY=0; RELEASE=0; TARGETS=()
for a in "$@"; do
  case "$a" in
    --no-test) TEST=0 ;;
    --install) INSTALL=1 ;;
    --cli-only) CLI_ONLY=1 ;;
    -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) TARGETS+=("$a") ;;
  esac
done
[ ${#TARGETS[@]} -gt 0 ] || { sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
if [ "${TARGETS[0]}" = release ]; then
  require_release
  RELEASE=1
  # Release artifacts are always obfuscated (Go core via garble, Dart, C ABI).
  # The seed is reproducible per release (VERSION + SHA, same derivation the
  # helper uses); a missing garble aborts here, never a plain fallback.
  export SPATE_OBFUSCATE=1
  export SPATE_OBF_SEED="${SPATE_OBF_SEED:-$(obf_seed)}"
  obf_require_garble
  # (check the count before slicing: an empty array trips bash 3.2 + set -u)
  [ ${#TARGETS[@]} -gt 1 ] || { echo "release: name at least one target (e.g. ./build release all)" >&2; exit 2; }
  TARGETS=("${TARGETS[@]:1}")
  TEST=1   # a release always runs go vet + tests: --no-test is ignored
fi

run_tests() {
  ensure_go
  [ "$TEST" = 1 ] || return 0
  say "go vet + tests"
  go vet ./...
  go test ./... 2>&1 | grep -v "no test files" | sed 's/^/    /'
}

do_mac() {
  ensure_go
  [ "$(uname -s)" = Darwin ] || { note "mac: needs a macOS host"; return 0; }
  need flutter "https://docs.flutter.dev/get-started/install" || return 0
  say "macOS $LABEL"
  # As for Windows below: the grep is wrapped so "no match" cannot mask the
  # script's own exit status, and a failed step stops the build instead of
  # carrying on to ship nothing.
  local status=0
  scripts/flutter-macos.sh build | { grep -E "==> app|error:" || true; } || status=$?
  [ "$status" = 0 ] && { scripts/package-macos.sh | { grep -E "^==> /|error" || true; } || status=$?; }
  if [ "$status" != 0 ]; then
    echo "==> macOS build failed (see above)" >&2
    exit 1
  fi
  # Only the installer is published. A zip of the bare app would lack the
  # native host and the browser registration, so it could not take over
  # downloads from a browser.
  label "$DIST/Spate-$VERSION.pkg" macos "spate-macos-$VERSION.pkg"
  if [ "$INSTALL" = 1 ]; then scripts/install-macos.sh | grep -E "^==>" || true; fi
}

do_windows() {
  ensure_go
  say "Windows $LABEL"
  need "${CC:-x86_64-w64-mingw32-gcc}" "brew install mingw-w64" || return 0
  # Filter the script's stdout down to its progress lines; stderr (compiler,
  # cp and zip errors, the bundle-missing message) reaches the terminal
  # untouched. The grep is wrapped so "no match" cannot fail the pipeline,
  # and with pipefail the pipeline's status is then the script's own.
  local status=0
  scripts/build-windows.sh | { grep -E "^==>" || true; } || status=$?
  if [ "$status" != 0 ]; then
    echo "==> Windows build failed (see above)" >&2
    exit 1
  fi
  # The full zip (same files as the installer plus the older console setup)
  # stays in dist/ for local use and is not published: one Windows download,
  # the setup .exe below. A build without the UI has only the CLI zip to offer.
  [ -f "$DIST/spate-windows-amd64.zip" ] && note "dist/spate-windows-amd64.zip (local only, not published)"
  if [ -f "$DIST/spate-windows-amd64-cli-only.zip" ]; then
    label "$DIST/spate-windows-amd64-cli-only.zip" windows "spate-windows-$VERSION-amd64-cli-only.zip"
  fi
  if command -v makensis >/dev/null; then
    if ui_bundle_ok "$DIST/windows-amd64"; then
      local pstatus=0
      scripts/package-windows.sh | { grep -E "^==>" || true; } || pstatus=$?
      if [ "$pstatus" != 0 ]; then
        echo "==> Windows installer packaging failed (see above)" >&2
        exit 1
      fi
      label "$DIST/Spate-Setup-$VERSION.exe" windows "spate-windows-$VERSION-amd64-setup.exe"
    else
      note "NSIS installer skipped: the Flutter Windows UI is built on Windows (scripts/flutter-windows.ps1); copy its Release folder to dist/windows-amd64/spate_app"
    fi
  else
    note "makensis missing (brew install makensis): no NSIS installer, spate-setup.exe built"
  fi
}

do_linux() {
  ensure_go
  say "Linux $LABEL"
  # (no array: bash 3.2 + set -u trips on an empty "${args[@]}")
  # (CLI_ONLY is 0 or 1, so ${CLI_ONLY:+...} would always pass the flag and
  # the desktop package would never be built.)
  local status=0 flag=""
  [ "$CLI_ONLY" = 1 ] && flag="--cli-only"
  scripts/package-linux.sh $flag | { grep -E "^==>|note:" || true; } || status=$?
  if [ "$status" != 0 ]; then
    echo "==> Linux build failed (see above)" >&2
    exit 1
  fi
  local f arch
  for f in "$DIST"/spate_"$VERSION"_*.deb; do
    [ -e "$f" ] || continue
    arch="${f##*_}"; label "$f" linux "spate-linux-$VERSION-$arch"          # ...-amd64.deb
  done
  for f in "$DIST"/spate-cli_"$VERSION"_*.deb; do
    [ -e "$f" ] || continue
    arch="${f##*_}"; label "$f" linux "spate-linux-cli-$VERSION-$arch"
  done
  make -s host-linux && note "dist/linux-{amd64,arm64}/spate-host"
}

do_android() {
  ensure_go
  say "Android $LABEL"
  if need gomobile "make tools" && [ -n "${ANDROID_NDK_HOME:-}${ANDROID_HOME:-}" ]; then
    make -s android && { mv -f "$DIST/spate.aar" "$DIST/spate-$VERSION.aar"; label "$DIST/spate-$VERSION.aar" android; }
  else
    note "libspate .aar skipped (needs gomobile + ANDROID_HOME/ANDROID_NDK_HOME)"
  fi
  if command -v flutter >/dev/null && [ -n "${ANDROID_HOME:-}${ANDROID_SDK_ROOT:-}" ]; then
    (cd apps/flutter && flutter build apk --release --build-name="$VERSION" --build-number="$BUILDNUM" 2>&1 | grep -E "Built|error" || true)
    local apk="apps/flutter/build/app/outputs/flutter-apk/app-release.apk"
    [ -f "$apk" ] && { cp "$apk" "$DIST/Spate-$VERSION.apk"; label "$DIST/Spate-$VERSION.apk" android; }
  else
    note "APK skipped (needs Flutter + Android SDK: ANDROID_HOME)"
  fi
}

do_ios() {
  ensure_go
  [ "$(uname -s)" = Darwin ] || { note "ios: needs a macOS host"; return 0; }
  say "iOS $LABEL"
  if need gomobile "make tools"; then
    make -s ios && { rm -rf "$DIST/Spate-$VERSION.xcframework"; mv "$DIST/Spate.xcframework" "$DIST/Spate-$VERSION.xcframework"; label "$DIST/Spate-$VERSION.xcframework" ios; }
  fi
  if command -v flutter >/dev/null; then
    (cd apps/flutter && flutter build ios --release --no-codesign --build-name="$VERSION" --build-number="$BUILDNUM" 2>&1 | grep -E "Built|error" || true)
    local app="apps/flutter/build/ios/iphoneos/Runner.app"
    if [ -d "$app" ]; then
      local zip="$DIST/Spate-$VERSION-ios-unsigned.zip"; rm -f "$zip"
      ditto -c -k --keepParent "$app" "$zip" && label "$zip" ios
      note "unsigned: sign with your team in Xcode (or flutter build ipa) for a device"
    fi
  fi
}

do_extension() {
  say "browser extension $LABEL"
  local ext_status=0
  scripts/package-extension.sh | { grep -E "^==>|unpacked" || true; } || ext_status=$?
  if [ "$ext_status" != 0 ]; then
    echo "==> extension packaging failed (see above)" >&2
    exit 1
  fi
  if [ "$(uname -s)" = Darwin ] && xcrun --find safari-web-extension-converter >/dev/null 2>&1; then
    # (re-packages internally, so the zips are labelled afterwards; the grep
    # is wrapped so "no match" cannot mask the script's own exit status)
    local status=0
    scripts/safari-extension.sh 2>&1 | { grep -E "==> installed|error|BUILD" || true; } || status=$?
    if [ "$status" != 0 ]; then
      echo "==> Safari extension build failed (see above)" >&2
      exit 1
    fi
    artifacts+=("$HOME/Applications/Spate for Safari.app")
  fi
  label "$DIST/spate-extension-$VERSION.zip" extension "spate-extension-chrome-$VERSION.zip"
  label "$DIST/spate-extension-firefox-$VERSION.zip" extension
}

do_bump() {
  local v="$1"
  [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "bump: version must be x.y.z" >&2; exit 2; }
  local old="$VERSION"
  printf '%s\n' "$v" > VERSION
  sed -i.bak "s/^version: .*/version: $v+1/" apps/flutter/pubspec.yaml && rm -f apps/flutter/pubspec.yaml.bak
  sed -i.bak "s/  version \"$old\"/  version \"$v\"/" packaging/homebrew/spate.rb && rm -f packaging/homebrew/spate.rb.bak
  sed -i.bak "s/$old/$v/g" packaging/winget/DeepakLohani.Spate.yaml && rm -f packaging/winget/DeepakLohani.Spate.yaml.bak
  scripts/package-extension.sh >/dev/null   # stamps the three manifests
  say "version $old -> $v"
  git --no-pager diff --stat | sed 's/^/    /'
}

for t in "${TARGETS[@]}"; do
  case "$t" in
    version) echo "version $VERSION  label $LABEL  build $BUILDNUM  ($SHA${DIRTY:+, uncommitted changes})" ;;
    clean) rm -rf "$DIST"; say "removed dist/" ;;
    bump) do_bump "${TARGETS[1]:-}"; exit 0 ;;
    mac|macos) run_tests; TEST=0; do_mac ;;
    windows|win) run_tests; TEST=0; do_windows ;;
    linux|deb) run_tests; TEST=0; do_linux ;;
    android) run_tests; TEST=0; do_android ;;
    ios) run_tests; TEST=0; do_ios ;;
    extension|ext) do_extension ;;
    all) run_tests; TEST=0; do_mac; do_windows; do_linux; do_extension; do_android; do_ios ;;
    *) [ "$t" = "${TARGETS[1]:-}" ] && [ "${TARGETS[0]}" = bump ] && continue; echo "unknown target: $t (see ./build --help)" >&2; exit 2 ;;
  esac
done

if [ ${#artifacts[@]} -gt 0 ]; then
  say "artifacts ($LABEL)"
  for a in "${artifacts[@]}"; do
    if [ -e "$a" ]; then printf '    %-60s %s\n' "${a#$ROOT/}" "$(du -sh "$a" | cut -f1)"; fi
  done
fi
