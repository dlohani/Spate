<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Direct-distribution build. The App Sandbox is off because the embedded
	     Go core listens on loopback for the browser extension, downloads from
	     arbitrary hosts, and writes to user-chosen folders. An App Store build
	     would need the sandbox plus security-scoped bookmarks. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
