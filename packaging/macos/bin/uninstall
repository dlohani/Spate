#!/bin/bash
# Remove Spate for the current user: login item, browser host registrations,
# the app and helper files. Settings, the pairing token and downloads are kept.
set -u
ROOT="$HOME/Library/Application Support/spate"
launchctl bootout "gui/$(id -u)/com.amlabs.spate" >/dev/null 2>&1 || true
rm -f "$HOME/Library/LaunchAgents/com.amlabs.spate.plist"
pkill -x spate_app >/dev/null 2>&1 || true
pkill -x spate-mac >/dev/null 2>&1 || true
AS="$HOME/Library/Application Support"
for b in Chromium Google/Chrome BraveSoftware/Brave-Browser "Microsoft Edge" Vivaldi; do
  rm -f "$AS/$b/NativeMessagingHosts/com.amlabs.spate.host.json"
done
rm -rf "$HOME/Applications/Spate.app" "$ROOT/bin" "$ROOT/extension"
pkgutil --forget com.amlabs.spate >/dev/null 2>&1 || true
pkgutil --forget com.amlabs.spate.app >/dev/null 2>&1 || true
echo "Spate removed. (Kept: $ROOT/settings.json, $ROOT/token and your downloads.)"
