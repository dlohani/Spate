#!/bin/bash
# Spate .pkg preinstall (runs before files are written): refuse a downgrade
# and stop any running instance so the swap is clean. The Distribution's
# installation-check already explains a downgrade in the Installer UI; this
# also covers `installer -pkg` from the command line.
set -u
NEW="@VERSION@"
plist="$HOME/Applications/Spate.app/Contents/Info.plist"
if [ -f "$plist" ]; then
  have="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$plist" 2>/dev/null || true)"
  build="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$plist" 2>/dev/null || true)"
  # Flutter template defaults = unstamped dev build: never blocks.
  if [ -n "$have" ] && ! { [ "$have" = "1.0.0" ] && [ "$build" = "1" ]; }; then
    newer="$(printf '%s\n%s\n' "$have" "$NEW" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)"
    if [ "$newer" = "$have" ] && [ "$have" != "$NEW" ]; then
      echo "Spate $have is installed; $NEW is older. Downgrades are not supported." >&2
      exit 1
    fi
  fi
fi
launchctl bootout "gui/$(id -u)/io.opensources.spate" >/dev/null 2>&1 || true
# Match the process name exactly (-x): a -f pattern would also kill any shell
# whose command line mentions the path.
pkill -x spate_app >/dev/null 2>&1 || true
pkill -x spate-mac >/dev/null 2>&1 || true

# A previous install under the product's old name (Cascade): stop it, drop its
# login item, app bundle, helper binaries and browser host manifests. Its
# settings, pairing token and queue are migrated by the core on first start.
launchctl bootout "gui/$(id -u)/dev.d3xt3r.cascade" >/dev/null 2>&1 || true
rm -f "$HOME/Library/LaunchAgents/dev.d3xt3r.cascade.plist"
pkill -x cascade_app >/dev/null 2>&1 || true
rm -rf "$HOME/Applications/Cascade.app" "$HOME/Library/Application Support/cascade/bin" "$HOME/Library/Application Support/cascade/extension"
for b in Chromium Google/Chrome BraveSoftware/Brave-Browser "Microsoft Edge" Vivaldi; do
  rm -f "$HOME/Library/Application Support/$b/NativeMessagingHosts/com.cascade.host.json"
done
rm -f "$HOME/Library/Application Support/Mozilla/NativeMessagingHosts/com.cascade.host.json"

# Identifiers were com.amlabs.* before the package became io.opensources.spate:
# drop the old login item, browser host manifests and installer records, and
# an app bundle that still carries the old identifier (the new one installs
# to the same path). Settings, the pairing token and the queue are untouched.
launchctl bootout "gui/$(id -u)/com.amlabs.spate" >/dev/null 2>&1 || true
rm -f "$HOME/Library/LaunchAgents/com.amlabs.spate.plist"
for b in Chromium Google/Chrome BraveSoftware/Brave-Browser "Microsoft Edge" Vivaldi Mozilla; do
  rm -f "$HOME/Library/Application Support/$b/NativeMessagingHosts/com.amlabs.spate.host.json"
done
oldid="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$HOME/Applications/Spate.app/Contents/Info.plist" 2>/dev/null || true)"
case "$oldid" in com.amlabs.*) rm -rf "$HOME/Applications/Spate.app" ;; esac
pkgutil --volume "$HOME" --forget com.amlabs.spate >/dev/null 2>&1 || true
pkgutil --volume "$HOME" --forget com.amlabs.spate.app >/dev/null 2>&1 || true
pkgutil --forget com.amlabs.spate >/dev/null 2>&1 || true
pkgutil --forget com.amlabs.spate.app >/dev/null 2>&1 || true
sleep 1
exit 0
