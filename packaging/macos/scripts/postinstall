#!/bin/bash
# Cascade .pkg postinstall (per-user domain): register the browser native host,
# add the login item, start the app. $2 is the install location.
set -u
# $2 is the package's install location: the cascade root (…/cascade), which
# contains bin/ and extension/. Fall back to the conventional path.
ROOT="${2:-$HOME/Library/Application Support/cascade}"
[ -d "$ROOT/bin" ] || ROOT="$HOME/Library/Application Support/cascade"
BIN="$ROOT/bin"
chmod +x "$BIN/cascade-host" "$BIN/cascade-mac" "$BIN/register-extension" "$BIN/uninstall" 2>/dev/null || true

# Browser host registration (also re-runnable later with an explicit ID).
"$BIN/register-extension" >/dev/null 2>&1 || true

# Login item: start hidden (menu-bar only).
LA="$HOME/Library/LaunchAgents"; mkdir -p "$LA"
PLIST="$LA/dev.d3xt3r.cascade.plist"
cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.d3xt3r.cascade</string>
  <key>ProgramArguments</key>
  <array><string>${BIN}/Cascade.app/Contents/MacOS/cascade_app</string><string>--background</string></array>
  <key>EnvironmentVariables</key><dict><key>CASCADE_BACKGROUND</key><string>1</string></dict>
  <key>RunAtLoad</key><true/>
</dict></plist>
PL
launchctl bootout "gui/$(id -u)/dev.d3xt3r.cascade" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || launchctl load "$PLIST" >/dev/null 2>&1 || true

# Start now (single-instance guard in the core prevents duplicates).
open -a "$BIN/Cascade.app" >/dev/null 2>&1 || true
exit 0
