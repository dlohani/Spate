#!/bin/bash
# Spate .pkg postinstall (per-user domain): register the browser native host,
# add the login item, start the app. $2 is the support install location.
set -u
# $2 is this component's install location: the spate support root, which
# contains bin/ and extension/. Fall back to the conventional path.
ROOT="${2:-$HOME/Library/Application Support/spate}"
[ -d "$ROOT/bin" ] || ROOT="$HOME/Library/Application Support/spate"
BIN="$ROOT/bin"
APP="$HOME/Applications/Spate.app"
chmod +x "$BIN/spate-host" "$BIN/register-extension" "$BIN/uninstall" 2>/dev/null || true

# One copy of the app only: earlier versions kept a second bundle and a
# helper binary under bin/.
rm -rf "$BIN/Spate.app" "$BIN/spate-mac"

# Browser host registration (also re-runnable later with an explicit ID).
"$BIN/register-extension" >/dev/null 2>&1 || true

# Login item: start hidden (menu-bar only).
LA="$HOME/Library/LaunchAgents"; mkdir -p "$LA"
PLIST="$LA/com.amlabs.spate.plist"
cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.amlabs.spate</string>
  <key>ProgramArguments</key>
  <array><string>${APP}/Contents/MacOS/spate_app</string><string>--background</string></array>
  <key>EnvironmentVariables</key><dict><key>SPATE_BACKGROUND</key><string>1</string></dict>
  <key>RunAtLoad</key><true/>
</dict></plist>
PL
launchctl bootout "gui/$(id -u)/com.amlabs.spate" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || launchctl load "$PLIST" >/dev/null 2>&1 || true

# Show the window (the agent started it hidden; a second open just raises it).
sleep 1
open -a "$APP" >/dev/null 2>&1 || true
exit 0
