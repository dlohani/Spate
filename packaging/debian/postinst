#!/bin/sh
# Spate .deb postinst: register the browser native-messaging host
# system-wide (Chrome, Chromium, Edge) and refresh desktop caches.
set -e
HOST=/usr/lib/spate/spate-host
EXT=/usr/share/spate/extension
NAME=com.amlabs.spate.host
DEVID=kamlaafhjnegfjdbnfajbanjfkemefga
CHROME_WEBSTORE_ID="@CHROME_WEBSTORE_ID@"
EDGE_ADDONS_ID="@EDGE_ADDONS_ID@"
# Chrome derives an unpacked extension's ID from its folder path:
# sha256(path), first 32 hex digits mapped a-p.
ID="$(printf '%s' "$EXT" | sha256sum | cut -c1-32 | tr '0123456789abcdef' 'abcdefghijklmnop')"
manifest="{
  \"name\": \"$NAME\",
  \"description\": \"Spate download manager native host\",
  \"path\": \"$HOST\",
  \"type\": \"stdio\",
  \"allowed_origins\": [\"chrome-extension://$ID/\", \"chrome-extension://$DEVID/\"${CHROME_WEBSTORE_ID:+, \"chrome-extension://$CHROME_WEBSTORE_ID/\"}${EDGE_ADDONS_ID:+, \"chrome-extension://$EDGE_ADDONS_ID/\"}]
}"
for d in /etc/opt/chrome/native-messaging-hosts \
         /etc/chromium/native-messaging-hosts \
         /etc/opt/edge/native-messaging-hosts; do
  mkdir -p "$d"
  printf '%s\n' "$manifest" > "$d/$NAME.json"
  chmod 0644 "$d/$NAME.json"
done
# Firefox (system-wide): fixed add-on ID, keyed by allowed_extensions.
mkdir -p /usr/lib/mozilla/native-messaging-hosts
printf '{\n  "name": "%s",\n  "description": "Spate download manager native host",\n  "path": "%s",\n  "type": "stdio",\n  "allowed_extensions": ["spate@amlabs.dev"]\n}\n' "$NAME" "$HOST" > "/usr/lib/mozilla/native-messaging-hosts/$NAME.json"
chmod 0644 "/usr/lib/mozilla/native-messaging-hosts/$NAME.json"
if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database -q /usr/share/applications || true; fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true; fi
# Published extension: system-wide registration makes Chrome/Chromium install
# it for every user on next start (Linux needs no prompt). Brave, Vivaldi and
# Edge are registered per user by spate-register.
if [ -n "$CHROME_WEBSTORE_ID" ]; then
  for d in /usr/share/google-chrome/extensions /usr/share/chromium/extensions; do
    mkdir -p "$d"
    printf '{ "external_update_url": "https://clients2.google.com/service/update2/crx" }\n' > "$d/$CHROME_WEBSTORE_ID.json"
  done
  echo "spate: Chrome/Chromium install the Spate extension from the store on next start."
  echo "spate: Brave, Vivaldi, Edge or another extension ID: run spate-register [ID] as your user."
else
  echo "spate: load $EXT in chrome://extensions (Developer mode -> Load unpacked)."
  echo "spate: Brave, Vivaldi or another extension ID: run spate-register [ID] as your user."
fi
exit 0
