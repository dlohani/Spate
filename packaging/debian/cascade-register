#!/bin/sh
# Register the Cascade browser native-messaging host for the current user's
# browsers (Chromium, Chrome, Brave, Edge, Vivaldi, snap Chromium), optionally
# authorizing extra extension IDs (from the extension's Options page).
#
#   cascade-register [EXTENSION_ID ...]
#
# The .deb already registers Chrome, Chromium and Edge system-wide; use this
# for the other browsers or when the extension was loaded from another path.
set -u
HOST=/usr/lib/cascade/cascade-host
EXT=/usr/share/cascade/extension
NAME=com.cascade.host
CHROME_WEBSTORE_ID="@CHROME_WEBSTORE_ID@"
EDGE_ADDONS_ID="@EDGE_ADDONS_ID@"
ID="$(printf '%s' "$EXT" | sha256sum | cut -c1-32 | tr '0123456789abcdef' 'abcdefghijklmnop')"
origins="\"chrome-extension://$ID/\", \"chrome-extension://kamlaafhjnegfjdbnfajbanjfkemefga/\""
[ -n "$CHROME_WEBSTORE_ID" ] && origins="$origins, \"chrome-extension://$CHROME_WEBSTORE_ID/\""
[ -n "$EDGE_ADDONS_ID" ] && origins="$origins, \"chrome-extension://$EDGE_ADDONS_ID/\""
for id in "$@"; do origins="$origins, \"chrome-extension://$id/\""; done
manifest="{
  \"name\": \"$NAME\",
  \"description\": \"Cascade download manager native host\",
  \"path\": \"$HOST\",
  \"type\": \"stdio\",
  \"allowed_origins\": [$origins]
}"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
n=0
for dir in \
  "$CFG/chromium/NativeMessagingHosts" \
  "$CFG/google-chrome/NativeMessagingHosts" \
  "$CFG/google-chrome-beta/NativeMessagingHosts" \
  "$CFG/BraveSoftware/Brave-Browser/NativeMessagingHosts" \
  "$CFG/microsoft-edge/NativeMessagingHosts" \
  "$CFG/vivaldi/NativeMessagingHosts" \
  "$HOME/snap/chromium/common/chromium/NativeMessagingHosts"; do
  [ -d "$(dirname "$dir")" ] || continue
  mkdir -p "$dir"
  printf '%s\n' "$manifest" > "$dir/$NAME.json"
  echo "registered: $dir/$NAME.json"
  n=$((n + 1))
done
if [ -d "$HOME/.mozilla" ]; then
  mkdir -p "$HOME/.mozilla/native-messaging-hosts"
  printf '{\n  "name": "%s",\n  "description": "Cascade download manager native host",\n  "path": "%s",\n  "type": "stdio",\n  "allowed_extensions": ["cascade@d3xt3r.dev"]\n}\n' "$NAME" "$HOST" > "$HOME/.mozilla/native-messaging-hosts/$NAME.json"
  echo "registered: $HOME/.mozilla/native-messaging-hosts/$NAME.json (Firefox)"
  n=$((n + 1))
fi
[ "$n" -gt 0 ] || echo "no browser profile folders found under $CFG"
# Published extension: make each browser install it from its store.
reg_store() { # config-dir store-id update-url
  [ -n "$2" ] && [ -d "$CFG/$1" ] || return 0
  mkdir -p "$CFG/$1/External Extensions"
  printf '{ "external_update_url": "%s" }\n' "$3" > "$CFG/$1/External Extensions/$2.json"
  echo "extension registered: $1 installs it from the store on next start"
}
CHROME_URL=https://clients2.google.com/service/update2/crx
for b in google-chrome chromium BraveSoftware/Brave-Browser vivaldi; do reg_store "$b" "$CHROME_WEBSTORE_ID" "$CHROME_URL"; done
reg_store microsoft-edge "$EDGE_ADDONS_ID" https://edge.microsoft.com/extensionwebstorebase/v1/crx
[ -n "$CHROME_WEBSTORE_ID" ] || echo "extension folder: $EXT  (chrome://extensions -> Developer mode -> Load unpacked)"
